# ============================================================
# Graph Database Benchmark Suite - Environment Configuration
# ============================================================

# ----------------------------------------------------------------
# CognoDB Cloud (Bolt-compatible, uses neo4j driver)
# ----------------------------------------------------------------
COGNODB_BOLT_URI=bolt+s://cognodb-example.databases.neo4j.io:7687
COGNODB_USERNAME=neo4j
COGNODB_PASSWORD=your-cognodb-password-here
COGNODB_DATABASE=neo4j

# ----------------------------------------------------------------
# Neo4j AuraDB
# ----------------------------------------------------------------
NEO4J_AURA_URI=neo4j+s://example.databases.neo4j.io
NEO4J_AURA_USERNAME=neo4j
NEO4J_AURA_PASSWORD=your-neo4j-auradb-password-here
NEO4J_AURA_DATABASE=neo4j

# ----------------------------------------------------------------
# TigerGraph Cloud
# ----------------------------------------------------------------
TG_HOST=https://example.i.tgcloud.io
TG_USERNAME=tigergraph
TG_PASSWORD=your-tigergraph-password-here
TG_GRAPHNAME=BenchmarkGraph
TG_SECRET=your-tigergraph-secret-here

# ----------------------------------------------------------------
# Memgraph (Docker, local Bolt)
# ----------------------------------------------------------------
MEMGRAPH_BOLT_URI=bolt://localhost:7687
MEMGRAPH_USERNAME=
MEMGRAPH_PASSWORD=
MEMGRAPH_DATABASE=memgraph

# ----------------------------------------------------------------
# ArcadeDB (Docker, REST API)
# ----------------------------------------------------------------
ARCADEDB_HOST=http://localhost
ARCADEDB_HTTP_PORT=2480
ARCADEDB_GRAPH_NAME=BenchmarkGraph
ARCADEDB_USERNAME=root
ARCADEDB_PASSWORD=arcadedb-password-here

# ----------------------------------------------------------------
# Benchmark Runtime Tunables
# ----------------------------------------------------------------
BENCHMARK_BATCH_SIZE=1000
BENCHMARK_WARMUP_ITERATIONS=10
BENCHMARK_READ_ITERATIONS=100
BENCHMARK_CONCURRENCY_LEVELS=1,10,40
BENCHMARK_READ_WRITE_RATIO=0.8
BENCHMARK_CONCURRENCY_DURATION_SECONDS=30
BENCHMARK_QUERY_TIMEOUT_SECONDS=30
